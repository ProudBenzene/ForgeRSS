# ForgeRSS 配置文件
# 使用方法: cp .env.example .env

# ==================== 基础配置 ====================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 每个 Feed 最大文章数
MAX_ARTICLES=50

# 运行间隔（秒），默认 21600 = 6小时
# Docker 持久运行模式下生效
RUN_INTERVAL=21600

# 是否全量刷新（忽略缓存）: true/false
FULL_REFRESH=false

# 是否使用 SQLite 存储: true/false
# 启用后数据保存到 data/forgerss.db
USE_DB=true

# ==================== 目录配置 ====================
# Docker 环境下无需修改，会自动挂载 volume

# 数据目录（SQLite 数据库）
# FORGERSS_DATA_DIR=./data

# 缓存目录（JSON 缓存）
# FORGERSS_CACHE_DIR=./cache

# Feed 输出目录
# FORGERSS_FEEDS_DIR=./feeds

# ==================== 图片代理（可选，暂未实现）====================

# 启用图片代理
# IMAGE_PROXY_ENABLED=false

# 代理服务器基础 URL
# IMAGE_PROXY_BASE_URL=https://your-domain.com/proxy
