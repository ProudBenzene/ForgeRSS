!feeds/.gitkeep
!data/.gitkeep

# Don't ignore generated feeds (for GitHub hosting)
!feeds/*.xml

# Weixin standalone bundle (managed by scripts/_bundle_weixin.py)
weixin_standalone/

# HTML dumps from tools/diagnose_login.py (regenerate as needed)
tools/login_dumps/
